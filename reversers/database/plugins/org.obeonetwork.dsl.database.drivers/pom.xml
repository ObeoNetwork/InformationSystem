<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.obeonetwork</groupId>
		<artifactId>parent</artifactId>
		<version>5.1.3-SNAPSHOT</version>
		<relativePath>../../../../releng/org.obeonetwork.informationsystem.parent/pom.xml</relativePath>
	</parent>

	<groupId>org.obeonetwork</groupId>
	<artifactId>org.obeonetwork.dsl.database.drivers</artifactId>

	<version>5.1.3-SNAPSHOT</version>
	<packaging>eclipse-plugin</packaging>
	<name>Database Model Drivers</name>


	<profiles>
		<profile>
		<!-- run "mvn install -Pdriver_update" to trigger this profile -->
			<id>driver_update</id>
			<build>
				<plugins>
					<plugin>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<phase>install</phase>
								<goals>
									<goal>copy</goal>
								</goals>
								<configuration>
									<artifactItems>
										<artifactItem>
											<groupId>com.h2database</groupId>
											<artifactId>h2</artifactId>
											<version>2.4.240</version>
											<overWrite>true</overWrite>
										</artifactItem>
										<artifactItem>
											<groupId>com.h2database</groupId>
											<artifactId>h2</artifactId>
											<version>1.4.200</version>
											<overWrite>true</overWrite>
										</artifactItem>
										<artifactItem>
											<groupId>org.mariadb.jdbc</groupId>
											<artifactId>mariadb-java-client</artifactId>
											<version>3.5.7</version>
											<overWrite>true</overWrite>
										</artifactItem>
										<artifactItem>
											<groupId>com.microsoft.sqlserver</groupId>
											<artifactId>mssql-jdbc</artifactId>
											<version>13.2.1.jre11</version>
											<overWrite>true</overWrite>
										</artifactItem>
										<artifactItem>
											<groupId>com.mysql</groupId>
											<artifactId>mysql-connector-j</artifactId>
											<version>9.5.0</version>
											<overWrite>true</overWrite>
										</artifactItem>
										<artifactItem>
											<groupId>com.oracle.database.jdbc</groupId>
											<artifactId>ojdbc17</artifactId>
											<version>23.26.0.0.0</version>
											<overWrite>true</overWrite>
										</artifactItem>
										<artifactItem>
											<groupId>org.postgresql</groupId>
											<artifactId>postgresql</artifactId>
											<version>42.7.9</version>
											<overWrite>true</overWrite>
										</artifactItem>
									</artifactItems>
									<outputDirectory>lib</outputDirectory>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>


</project>
