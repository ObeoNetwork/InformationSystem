[module generate('http://www.eclipse.org/emf/compare', 'http://www.obeonetwork.org/dsl/database/evolution/1.0', 'http://www.obeonetwork.org/dsl/database/1.0')/]

[import org::obeonetwork::dsl::database::compare::tests::gen::services::utilServices/]

[comment encoding = UTF-8 /]
[template public generateComparison(aComparison : compare::Comparison)]
  [aComparison.matches->select(aMatch | aMatch.left.oclIsKindOf(database::DataBase))/][/template]

[template public generateComparison(aMatch : compare::Match)]
  [OrderedSet{aMatch.left}->filter(database::DataBase)->asSequence()->collect(temp1 | temp1.name)/]
  [aMatch.generateDifferences()/]	[/template]

[template public generateDifferences(aMatch : compare::Match)]
  [for (aDiff : dbevolution::DBDiff | aMatch.differences->filter(dbevolution::DBDiff))]
    	+ [aMatch.differences->filter(dbevolution::DBDiff)->asSequence()->collect(temp2 | temp2.getLabel())/]
    	[aMatch.submatches->asSequence()->collect(temp3 | temp3.generateDifferences())/]	
  [/for]
[/template]