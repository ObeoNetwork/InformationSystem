[module comparisonFile('http://www.eclipse.org/emf/compare', 'http://www.obeonetwork.org/dsl/database/evolution/1.0', 'http://www.obeonetwork.org/dsl/database/1.0')/]

[import org::obeonetwork::dsl::database::compare::tests::gen::services::utilServices/]

[comment encoding = UTF-8 /]
[template public genComparison(aComparison : compare::Comparison)]
  [file ('result.txt', overwrite, 'UTF-8')]
    [aComparison.matches->select(aMatch | aMatch.left.oclIsKindOf(database::DataBase))->asSequence()->collect(temp1 | temp1.genComparison())/]
  [/file]
[/template]

[template public genComparison(aMatch : compare::Match)]
  [aMatch.getLabel()/]
  [aMatch.genDifferences()/]	[/template]

[template public genDifferences(aMatch : compare::Match)]
  [for (aDiff : dbevolution::DBDiff | aMatch.differences->filter(dbevolution::DBDiff))]
    	[aDiff.genDifferences()/]
  [/for]
[/template]

[template public genDifferences(aDiff : compare::Diff)]
  + [aDiff.getLabel()/]
  [for (aSubDiff : compare::Diff | aDiff.getSubDifferences())]
    	[aSubDiff.genDifferences()/]	
  [/for]
[/template]