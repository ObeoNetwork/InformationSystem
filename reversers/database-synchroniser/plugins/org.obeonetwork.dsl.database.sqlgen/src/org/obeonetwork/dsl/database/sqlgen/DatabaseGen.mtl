[module DatabaseGen('http://www.obeonetwork.org/dsl/database/evolution/1.0', 'http://www.obeonetwork.org/dsl/database/1.0', 'http://www.eclipse.org/emf/compare', 'http://www.obeonetwork.org/dsl/typeslibrary/1.0')/]

[import org::obeonetwork::dsl::database::sqlgen::TableGen/]
[import org::obeonetwork::dsl::database::sqlgen::PrimaryKeyGen/]
[import org::obeonetwork::dsl::database::sqlgen::ConstraintGen/]
[import org::obeonetwork::dsl::database::sqlgen::ForeignKeyGen/]
[import org::obeonetwork::dsl::database::sqlgen::IndexGen/]
[import org::obeonetwork::dsl::database::sqlgen::SequenceGen/]
[import org::obeonetwork::dsl::database::sqlgen::ViewGen/]
[import org::obeonetwork::dsl::database::gen::common::services::UtilServices/]

[comment encoding = UTF-8 /]
[comment @main/]
[template public genSQLForDatabase(changeSet : compare::Comparison) post(self.trim())]
  
  [let diffs : Sequence(dbevolution::DBDiff) = changeSet.getOrderedChanges()]
    [diffs->asSequence()->genSQLForTables()/]
    [diffs->asSequence()->genSQLForPrimaryKeys()/]
    [diffs->asSequence()->genSQLForConstraints()/]
    [diffs->asSequence()->genSQLForForeignKeys()/]
    [diffs->asSequence()->genSQLForIndex()/]
    [diffs->asSequence()->genSQLForSequences()/]
    [diffs->asSequence()->genSQLForViews()/]
  [/let]
  
[/template]

[template private genGeneralScript(changeSet : compare::Comparison)]
  [file ('run.sql', overwrite, 'UTF-8')]
    drop-tables
    drop-index
    
    alter-pk
    alter-tables
    
    create-tables
    create(index
  [/file]
[/template]