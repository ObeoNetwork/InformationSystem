[module SequenceGen('http://www.obeonetwork.org/dsl/database/evolution/1.0', 'http://www.obeonetwork.org/dsl/database/1.0', 'http://www.eclipse.org/emf/compare')/]

[import org::obeonetwork::dsl::database::sqlgen::services::names/]
[import org::obeonetwork::dsl::database::gen::common::services::TypesServices/]

[comment encoding = UTF-8 /]
[template public genSQLForSequences(diffs : Sequence(dbevolution::DBDiff)) post(self.trim())]
  [let addSequenceDiffs : Sequence(dbevolution::AddSequence) = diffs->filter(dbevolution::AddSequence)]
    [if (addSequenceDiffs->notEmpty())]
      [file ('create-sequences.sql', overwrite, 'UTF-8')]
        [for (addSequence : dbevolution::AddSequence | addSequenceDiffs)]
          [addSequence.genCreateSequence()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
  
  [let removeSequenceDiffs : Sequence(dbevolution::RemoveSequence) = diffs->filter(dbevolution::RemoveSequence)]
    [if (removeSequenceDiffs->notEmpty())]
      [file ('drop-sequences.sql', overwrite, 'UTF-8')]
        [for (removeSequence : dbevolution::RemoveSequence | removeSequenceDiffs)]
          [removeSequence.genDropSequence()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
  
  [let updateSequenceDiffs : Sequence(dbevolution::UpdateSequence) = diffs->filter(dbevolution::UpdateSequence)]
    [if (updateSequenceDiffs->notEmpty())]
      [file ('alter-sequences.sql', overwrite, 'UTF-8')]
        [for (updateSequence : dbevolution::UpdateSequence | updateSequenceDiffs)]
          [updateSequence.genUpdateSequence()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
[/template]

[comment ----------- SEQUENCE ----------- /]
[template private genUpdateSequence(updateSequence : dbevolution::UpdateSequence) post(self.trim())]
  [if (updateSequence.sequence.name = updateSequence.newSequence.name)]
    [updateSequence.newSequence.genUpdateSequence()/]
  [else]
    [updateSequence.sequence.genDropSequence()/]
    [updateSequence.newSequence.genCreateSequence()/]
  [/if]
[/template]

[template private genUpdateSequence(sequence : database::Sequence) post(self.trim())]
  [sequence.genSequenceDoc()/]
  ALTER SEQUENCE [sequence.name()/][sequence.genIncrementBy()/][sequence.genStartWith()/][sequence.genMinValue()/][sequence.genMaxValue()/][sequence.genCycle()/];[/template]

[template private genDropSequence(removeSequence : dbevolution::RemoveSequence) post(self.trim())]
  [removeSequence.sequence.genDropSequence()/][/template]

[template private genDropSequence(sequence : database::Sequence) post(self.trim())]
  [sequence.genSequenceDoc()/]
  DROP SEQUENCE [sequence.fullname()/];[/template]

[template private genCreateSequence(addSequence : dbevolution::AddSequence) post(self.trim())]
  [addSequence.sequence.genCreateSequence()/][/template]

[template private genSequenceDoc(sequence : database::Sequence) post(self.trim())]
  -- ==============================================================
  --  Sequence : [sequence.name()/]                                    
  -- ==============================================================[/template]

[template private genCreateSequence(sequence : database::Sequence) post(self.trim())]
  [sequence.genSequenceDoc()/]
  CREATE SEQUENCE [sequence.fullname()/][sequence.genIncrementBy()/][sequence.genMinValue()/][sequence.genMaxValue()/][sequence.genStartWith()/][sequence.genCache()/][sequence.genCycle()/];
  [sequence.genSequenceComment()/][/template]

[query private isValidValue(value : ecore::EBigInteger) : Boolean = not (value = null)/]

[template private genIncrementBy(sequence : database::Sequence)]
   [if (sequence.increment.isValidValue())]
     INCREMENT BY [sequence.increment/][/if][/template]

[template private genStartWith(sequence : database::Sequence)]
  [if (sequence.start.isValidValue())]
     START WITH [sequence.start/][/if][/template]

[template private genMinValue(sequence : database::Sequence)]
  [if (sequence.minValue.isValidValue() and sequence.minValue <> 1)]
     MINVALUE [sequence.minValue/]
  [/if][/template]

[template private genMaxValue(sequence : database::Sequence)]
  [if (sequence.maxValue.isValidValue() and sequence.maxValue <> -1)]
     MAXVALUE [sequence.maxValue/]
  [/if][/template]

[template private genCycle(sequence : database::Sequence)]
  [if (sequence.cycle = false)][if (sequence.isTargetOracle())] NOCYCLE[else] NO CYCLE[/if][else] CYCLE[/if][/template]

[template private genCache(sequence : database::Sequence)]
  [if (sequence.cacheSize.isValidValue())]
     CACHE [sequence.cacheSize/]
  [/if][/template]

[template private genSequenceComment(sequence : database::Sequence) post(self.trim())]
  [if (sequence.comments <> null and sequence.comments.size() > 0 and not sequence.isTargetOracle())]
    COMMENT ON SEQUENCE [sequence.fullname()/] IS '[sequence.comments.replaceAll('\'', '\'\'')/]';
  [/if][/template]
