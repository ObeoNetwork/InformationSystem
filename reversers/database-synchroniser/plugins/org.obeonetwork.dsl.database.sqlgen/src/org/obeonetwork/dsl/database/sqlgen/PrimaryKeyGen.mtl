[module PrimaryKeyGen('http://www.obeonetwork.org/dsl/database/evolution/1.0', 'http://www.obeonetwork.org/dsl/database/1.0', 'http://www.eclipse.org/emf/compare', 'http://www.obeonetwork.org/dsl/typeslibrary/1.0')/]

[import org::obeonetwork::dsl::database::sqlgen::services::services/]
[import org::obeonetwork::dsl::database::sqlgen::services::names/]
[import org::obeonetwork::dsl::database::gen::common::services::UtilServices/]

[comment encoding = UTF-8 /]
[template public genSQLForPrimaryKeys(diffs : Sequence(dbevolution::DBDiff)) post(self.trim())]
  [let addPrimaryKeyDiffs : Sequence(dbevolution::AddPrimaryKey) = diffs->filter(dbevolution::AddPrimaryKey)]
    [if (addPrimaryKeyDiffs->notEmpty() and not addPrimaryKeyDiffs->asSequence()->isForMySQL())]
      
      [file ('create-pk.sql', overwrite, 'UTF-8')]
        [for (addPk : dbevolution::AddPrimaryKey | addPrimaryKeyDiffs)]
          [addPk.genCreatePK()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
  
  [let removePKDiffs : Sequence(dbevolution::RemovePrimaryKey) = diffs->filter(dbevolution::RemovePrimaryKey)->asSequence()->filterRelatedToRemoveTable()]
    [if (removePKDiffs->notEmpty())]
      [file ('drop-pk.sql', overwrite, 'UTF-8')]
        [for (removePK : dbevolution::RemovePrimaryKey | removePKDiffs)]
          [removePK.genDropPK()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
  
  [let updatePrimaryKeyDiffs : Sequence(dbevolution::UpdatePrimaryKey) = diffs->filter(dbevolution::UpdatePrimaryKey)]
    [if (updatePrimaryKeyDiffs->notEmpty())]
      [file ('alter-pk.sql', overwrite, 'UTF-8')]
        [for (updatePK : dbevolution::UpdatePrimaryKey | updatePrimaryKeyDiffs)]
          [updatePK.genAlterPK()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
[/template]

[query private isForMySQL(diffs : Sequence(dbevolution::AddPrimaryKey)) : Boolean = diffs->notEmpty() and diffs->first().primaryKey.isTargetMySqlOrMariaDB()/]

[template private genPKDoc(primaryKey : database::PrimaryKey) post(self.trim())]
  -- ==============================================================
  --  Primary Key : [primaryKey.name/]                                    
  -- ==============================================================[/template]

[template private genCreatePK(addPK : dbevolution::AddPrimaryKey) post(self.trim())]
  [addPK.primaryKey.genPKDoc()/]
  [addPK.primaryKey.genCreatePK()/][/template]

[template private genDropPK(removePK : dbevolution::RemovePrimaryKey) post(self.trim())]
  [removePK.primaryKey.genPKDoc()/]
  [removePK.primaryKey.genDropPK()/][/template]

[template private genAlterPK(updatePK : dbevolution::UpdatePrimaryKey) post(self.trim())]
  [updatePK.newPrimaryKey.genPKDoc()/]
  [updatePK.primaryKey.genDropPK()/]
  [updatePK.newPrimaryKey.genCreatePK()/][/template]

[template private genCreatePK(pk : database::PrimaryKey) post(self.trim())]
  [if (pk.columns->notEmpty())]
    [let table : database::Table = pk.columns->first().owner.oclAsType(database::Table)]
      [pk.genUniquePKIndex(table)/]
      ALTER TABLE [table.fullname()/] ADD CONSTRAINT [pk.genPkConstraintName()/] PRIMARY KEY([pk.columns->asSequence()->collect(temp1 | temp1.name)->sep(', ')/]);[/let]
  [/if]
[/template]

[template private genUniquePKIndex(pk : database::PrimaryKey, table : database::Table) ? (not pk.isTargetPostgreSQL() and not pk.isTargetH2())]
  CREATE UNIQUE INDEX [pk.genPkConstraintName()/] ON [table.fullname()/]([pk.columns->asSequence()->collect(temp2 | temp2.name)->sep(', ')/]);[/template]

[template private genDropPK(pk : database::PrimaryKey) post(self.trim())]
  [let table : database::Table = pk.columns->first().owner.oclAsType(database::Table)]ALTER TABLE [table.fullname()/] DROP CONSTRAINT [pk.genPkConstraintName()/];[/let][/template]

[template public genPkConstraintName(pk : database::PrimaryKey) post(self.trim())]
  [if (pk.isTargetOracle())][pk.name/][else][pk.owner.name/]_PK1_1[/if][/template]

[query private filterRelatedToRemoveTable(diffs : Sequence(dbevolution::RemovePrimaryKey)) : Sequence(dbevolution::RemovePrimaryKey) = diffs->reject(temp3 | temp3.getRelatedDiff().isRelatedToRemoveTable())->asSequence()/]

[query private isRelatedToRemoveTable(diff : compare::Diff) : Boolean = not (diff = null) and diff.oclIsKindOf(dbevolution::RemoveTable)/]

[query private getRelatedDiff(diff : compare::Diff) : compare::Diff = diff.getRelatedDiff()/]