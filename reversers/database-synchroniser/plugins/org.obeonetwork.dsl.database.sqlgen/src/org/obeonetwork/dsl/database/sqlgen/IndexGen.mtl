[module IndexGen('http://www.obeonetwork.org/dsl/database/evolution/1.0', 'http://www.obeonetwork.org/dsl/database/1.0', 'http://www.eclipse.org/emf/compare', 'http://www.obeonetwork.org/dsl/typeslibrary/1.0')/]

[import org::obeonetwork::dsl::database::sqlgen::services::services/]
[import org::obeonetwork::dsl::database::sqlgen::services::names/]

[comment encoding = UTF-8 /]
[query private shouldGenerateIndex(index : database::Index) : Boolean = (index.owner.primaryKey = null or index.ID <> index.owner.primaryKey.ID) and (not index.isTargetOracle() or not index.isIndexOnPKColumns())/]

[template public genSQLForIndex(diffs : Sequence(dbevolution::DBDiff)) post(self.trim())]
  [let addIndexDiffs : Sequence(dbevolution::AddIndex) = diffs->filter(dbevolution::AddIndex)->reject(temp1 | not temp1.index.shouldGenerateIndex())]
    [if (addIndexDiffs->notEmpty())]
      [file ('create-index.sql', overwrite, 'UTF-8')]
        [for (addIndex : dbevolution::AddIndex | addIndexDiffs)]
          [addIndex.genCreateIndex()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
  
  [let removeIndexDiffs : Sequence(dbevolution::RemoveIndex) = diffs->filter(dbevolution::RemoveIndex)->reject(temp2 | not temp2.index.shouldGenerateIndex())]
    [if (removeIndexDiffs->notEmpty())]
      [file ('drop-index.sql', overwrite, 'UTF-8')]
        [for (removeIndex : dbevolution::RemoveIndex | removeIndexDiffs)]
          [removeIndex.genDropIndex()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
  
  [let alterIndexDiffs : Sequence(dbevolution::UpdateIndex) = diffs->filter(dbevolution::UpdateIndex)->reject(temp3 | not temp3.index.shouldGenerateIndex())]
    [if (alterIndexDiffs->notEmpty())]
      [file ('alter-index.sql', overwrite, 'UTF-8')]
        [for (updateIndex : dbevolution::UpdateIndex | alterIndexDiffs)]
          [updateIndex.genAlterIndex()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
[/template]

[template private genIndexDoc(index : database::Index) post(self.trim())]
  -- ==============================================================
  --  Index : [index.name/]                                    
  -- ==============================================================[/template]

[template private genCreateIndex(addIndex : dbevolution::AddIndex) ? (self.index.shouldGenerateIndex()) post(self.trim())]
  [addIndex.index.genIndexDoc()/]
  [addIndex.index.oclAsType(database::Index).genCreateIndex()/][/template]

[template private genDropIndex(removeIndex : dbevolution::RemoveIndex) post(self.trim())]
  [removeIndex.index.genIndexDoc()/]
  [removeIndex.index.oclAsType(database::Index).genDropIndex()/][/template]

[template private genAlterIndex(updateIndex : dbevolution::UpdateIndex) post(self.trim())]
  [updateIndex.newIndex.genIndexDoc()/]
  [updateIndex.index.oclAsType(database::Index).genDropIndex()/]
  [updateIndex.newIndex.oclAsType(database::Index).genCreateIndex()/][/template]

[template private genStorageClause(index : database::Index)]
  [if (index.owner.owner.oclIsKindOf(database::Schema) and not (index.getTable().isTargetMySqlOrMariaDB() or index.getTable().isTargetPostgreSQL() or index.getTable().isTargetOracle() or index.getTable().isTargetH2()))]
    
      pctfree 10
      pctused 40
      initrans 1
      online
      compute statistics
      tablespace TS_INDEX_[index.owner.owner.oclAsType(database::Schema).name.toUpper()/]
      logging
      nosort
      noparallel
      parallel
      (
           1
      )[/if]
[/template]

[template private genCreateIndex(index : database::Index) ? (index.shouldGenerateIndex()) post(self.trim())]
  [if (index.elements->forAll(temp6 | not (temp6.column = null)))]
    CREATE [if (index.unique)]UNIQUE [/if]INDEX [index.name/] ON [index.getTable().fullname()/]([index.elements->asSequence()->collect(temp4 | temp4.column)->collect(temp5 | temp5.name)->sep(', ')/])[index.genStorageClause()/]; 
  [/if]
[/template]

[template private genDropIndex(index : database::Index) ? (index.shouldGenerateIndex() and index.isTargetPostgreSQL()) post(self.trim())]
  DROP INDEX IF EXISTS [index.owner.genSchemaPrefix()/][index.name/];[/template]

[template private genDropIndex(index : database::Index) ? (index.shouldGenerateIndex()) post(self.trim())]
  ALTER TABLE [index.owner.name()/] DROP INDEX [index.name/];[/template]

[query private getTable(index : database::Index) : database::Table = index.owner.oclAsType(database::Table)/]