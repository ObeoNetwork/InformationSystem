[module ViewGen('http://www.obeonetwork.org/dsl/database/evolution/1.0', 'http://www.obeonetwork.org/dsl/database/1.0', 'http://www.eclipse.org/emf/compare', 'http://www.obeonetwork.org/dsl/typeslibrary/1.0')/]

[import org::obeonetwork::dsl::database::sqlgen::services::services/]
[import org::obeonetwork::dsl::database::sqlgen::services::names/]

[comment encoding = UTF-8 /]
[template public genSQLForViews(diffs : Sequence(dbevolution::DBDiff)) post(self.trim())]
  [let addViewDiffs : Sequence(dbevolution::AddView) = diffs->filter(dbevolution::AddView)]
    [if (addViewDiffs->notEmpty())]
      [file ('create-views.sql', overwrite, 'UTF-8')]
        [for (addView : dbevolution::AddView | addViewDiffs)]
          [addView.genCreateView()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
  
  [let removeViewDiffs : Sequence(dbevolution::RemoveView) = diffs->filter(dbevolution::RemoveView)]
    [if (removeViewDiffs->notEmpty())]
      [file ('drop-views.sql', overwrite, 'UTF-8')]
        [for (removeView : dbevolution::RemoveView | removeViewDiffs)]
          [removeView.genDropView()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
  
  [let alterViewDiffs : Sequence(dbevolution::AlterView) = diffs->filter(dbevolution::AlterView)]
    [if (alterViewDiffs->notEmpty())]
      [file ('alter-views.sql', overwrite, 'UTF-8')]
        [for (alterView : dbevolution::AlterView | alterViewDiffs)]
          [alterView.genAlterView()/]
          
        [/for]
      [/file]
    [/if]
  [/let]
[/template]

[comment ----------- TABLE ----------- /]
[template private genViewDoc(view : database::View) post(self.trim())]
  -- ==============================================================
  --  View : [view.name()/]                                    
  -- ==============================================================[/template]

[template private genDropView(removeView : dbevolution::RemoveView) post(self.trim())]
  [let view : database::View = removeView.view.oclAsType(database::View)]
    [view.genViewDoc()/]
    DROP VIEW [view.fullname()/];
  [/let]
[/template]

[template private getSchemaName(view : database::View) post(self.trim())]
  [view.owner.oclAsType(database::Schema).name.toUpper()/][/template]

[template private genCreateView(addView : dbevolution::AddView) post(self.trim())]
  [let view : database::View = addView.view.oclAsType(database::View)]
    [view.genViewDoc()/]
    [view.createViewStatement()/] AS [view.getViewQuery()/]
    [view.genCreateViewComment()/]
  [/let]
[/template]

[template private genAlterView(alterView : dbevolution::AlterView) post(self.trim())]
  [alterView.view.alterViewStatement(alterView.target.oclAsType(database::View))/][/template]

[template private alterViewStatement(newView : database::View, oldView : database::View)]
  [newView.genViewDoc()/]
  DROP VIEW [oldView.fullname()/];
  [newView.createViewStatement()/] AS [newView.getViewQuery()/]
  [newView.genCreateViewComment()/][/template]

[template private createViewStatement(view : database::View) ? (not view.isTargetSqlServer())]
  CREATE OR REPLACE VIEW [view.fullname()/][/template]

[template private createViewStatement(view : database::View) ? (view.isTargetSqlServer())]
  CREATE VIEW [view.fullname()/][/template]

[template private genCreateViewComment(view : database::View) ? (view.comments <> null and view.comments.size() > 0) post(self.trim())]
  COMMENT ON VIEW [view.fullname()/] IS '[view.comments.replaceAll('\'', '\'\'')/]';[/template]