[module names('http://www.obeonetwork.org/dsl/database/evolution/1.0', 'http://www.obeonetwork.org/dsl/database/1.0', 'http://www.eclipse.org/emf/compare', 'http://www.obeonetwork.org/dsl/typeslibrary/1.0')/]

[import org::obeonetwork::dsl::database::sqlgen::services::services/]

[comment encoding = UTF-8 /]
[template public fullname(table : database::Table) post(self.trim())]
  [table.genSchemaPrefix()/][table.name.toUpper()/]
[/template]

[template public fullname(view : database::View) post(self.trim())]
  [view.genSchemaPrefix()/][view.name.toUpper()/]
[/template]

[template public fullname(sequence : database::Sequence) post(self.trim())]
  [sequence.genSchemaPrefix()/][sequence.name.toUpper()/]
[/template]

[template public name(table : database::Table) post(self.trim())]
  [table.name.toUpper()/]
[/template]

[template public name(view : database::View) post(self.trim())]
  [view.name.toUpper()/]
[/template]

[template public name(column : database::Column) post(self.trim())]
  [column.name/]
[/template]

[template public name(schema : database::Schema) post(self.trim())]
  [schema.name.toUpper()/]
[/template]

[template public name(sequence : database::Sequence) post(self.trim())]
  [sequence.name.toUpper()/]
[/template]

[template public genSchemaPrefix(table : database::Table) post(self.trim())]
  [if (table.supportsSchema() and table.eContainer().oclIsKindOf(database::Schema))][table.eContainer().oclAsType(database::Schema).name()/].[/if]
[/template]

[template public genSchemaPrefix(view : database::View) post(self.trim())]
  [if (view.supportsSchema() and view.eContainer().oclIsKindOf(database::Schema))][view.eContainer().oclAsType(database::Schema).name()/].[/if]
[/template]

[template public genSchemaPrefix(sequence : database::Sequence) post(self.trim())]
  [if (sequence.supportsSchema() and sequence.eContainer().oclIsKindOf(database::Schema))][sequence.eContainer().oclAsType(database::Schema).name()/].[/if]
[/template]