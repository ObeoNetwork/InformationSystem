+    /**
+     * Encodes a JPEG image without the SWT GTK native encoder, which can silently fail when its RGBA input is rejected.
+     * Transparent pixels are composited against white because JPEG does not support alpha.
+     *
+     * @param stream
+     *            the destination stream, which remains open
+     * @param imageData
+     *            the image to encode
+     * @throws IOException
+     *             if no JPEG writer is available or encoding fails
+     */
+    private static void saveJPEGToOutputStream(OutputStream stream, ImageData imageData) throws IOException {
+        Iterator<ImageWriter> writers = ImageIO.getImageWritersByFormatName("jpeg"); //$NON-NLS-1$
+        if (!writers.hasNext()) {
+            throw new IOException(Messages.DiagramEditPartService_jpegWriterUnavailable);
+        }
+        ImageWriter writer = writers.next();
+        try {
+            BufferedImage argbImage = ImageConverter.convertFromImageData(imageData);
+            BufferedImage rgbImage = new BufferedImage(argbImage.getWidth(), argbImage.getHeight(), BufferedImage.TYPE_INT_RGB);
+            Graphics2D graphics = rgbImage.createGraphics();
+            try {
+                graphics.setColor(Color.WHITE);
+                graphics.fillRect(0, 0, rgbImage.getWidth(), rgbImage.getHeight());
+                graphics.drawImage(argbImage, 0, 0, null);
+            } finally {
+                graphics.dispose();
+            }
+
+            try (ImageOutputStream output = new MemoryCacheImageOutputStream(stream)) {
+                writer.setOutput(output);
+                writer.write(null, new IIOImage(rgbImage, null, null), writer.getDefaultWriteParam());
+            }
+        } finally {
+            writer.dispose();
+        }
+    }
