<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="org.obeonetwork.cinematic.gen.html.ide.ui.handlers.MainGeneratorHandler"
            commandId="org.obeonetwork.cinematic.gen.html.ide.ui.commands.mainGeneratorCommand">
      </handler>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.obeonetwork.is.designer.menu?after=additions">
        <command
              commandId="org.obeonetwork.cinematic.gen.html.ide.ui.commands.mainGeneratorCommand"
              id="org.obeonetwork.cinematic.gen.html.ide.ui.menus.mainGeneratorCommand.file"
              label="Generate Html">
           <visibleWhen
                 checkEnabled="false">
              <with
                    variable="selection">
                 <iterate
                       ifEmpty="false"
                       operator="and">
                    <and>
                       <instanceof
                             value="org.eclipse.core.resources.IFile">
                       </instanceof>
                       <test
                             property="org.eclipse.core.resources.extension"
                             value="cinematic">
                       </test>
                    </and>
                 </iterate>
              </with>
           </visibleWhen>
        </command>
      </menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <category
            id="org.obeonetwork.is.designer"
            name="IS Designer">
      </category>
      <command
            categoryId="org.obeonetwork.is.designer"
            id="org.obeonetwork.cinematic.gen.html.ide.ui.commands.mainGeneratorCommand"
            name="Generate Html">
      </command>
   </extension>

</plugin>
